# Copy to .env.jenkins (git-ignored) and fill in.
# AWS credentials are added separately, see the README ("aws configure export-credentials").

# Password for the Jenkins user "admin"
JENKINS_ADMIN_PASSWORD=change-me

# Password for the Grafana "admin" user
GRAFANA_ADMIN_PASSWORD=change-me-too

# Which repository and branch the pipeline job reads Jenkinsfile.iac from
REPO_URL=https://github.com/bharathMoger18/TodoSummaryAssistant.git
REPO_BRANCH=iac-pipeline
