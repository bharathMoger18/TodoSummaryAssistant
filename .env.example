# Copy this file to .env and fill in the values. Never commit .env.
# docker compose reads .env automatically from the repo root.

# --- Database (local MySQL container started by docker compose) ---
DB_NAME=todo_db
DB_PASSWORD=change-me-local-password

# --- External services ---
# Optional for local runs. The "Summarize and send to Slack" feature needs real values.
COHERE_API_KEY=your_cohere_api_key_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# --- Host ports ---
FRONTEND_PORT=3000

# --- Production (EC2) ---
# deploy.sh reads these from SSM Parameter Store (/todo/*); nothing is stored in the repo.
# DB_HOST=<rds-endpoint>
# DB_USERNAME=<db-user>
# DB_PASSWORD=<db-password>
# COHERE_API_KEY, SLACK_WEBHOOK_URL (same names as above)
# ECR_REGISTRY, IMAGE_TAG, METRICS_BIND_IP are set by deploy.sh
