# Copy this file to .env and fill in the values. Never commit .env.
# docker compose reads .env automatically from the repo root.

# --- Database (local MySQL container started by docker compose) ---
DB_NAME=todo_db
DB_PASSWORD=change-me-local-password

# --- External services ---
# Optional for local runs. The "Summarize and send to Slack" feature needs real values.
COHERE_API_KEY=your_cohere_api_key_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# --- Host ports ---
FRONTEND_PORT=3000

# --- AWS (used on EC2 instead of the local MySQL container; set by the deploy pipeline) ---
# SPRING_DATASOURCE_URL=jdbc:mysql://<rds-endpoint>:3306/todo_db
# SPRING_DATASOURCE_USERNAME=<db-user>
# SPRING_DATASOURCE_PASSWORD=<db-password>
