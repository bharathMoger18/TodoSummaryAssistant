server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # React single-page app: unknown paths fall back to index.html
    location / {
        try_files $uri /index.html;
    }

    # Forward API calls to the Spring Boot backend
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $backend http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $backend;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Lightweight endpoint for container health checks
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
